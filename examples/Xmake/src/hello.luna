Type:
    __func: (constrictions) ->
        where constrictions (T) ->

local MyType = Table
    foo: Number
    bar: 

gen_fun: (anything) ->
    match (local T = typeof anything)
        Number: ->
            println "Dealing number!"
        String: ->
            println `Dealing #{anything}!`

main: ->
