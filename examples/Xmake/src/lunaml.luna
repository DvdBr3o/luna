local { :head, :meta, :body, :div } = require "lunaml"
local lss = require "lunass" -- luna style sheet

local mystyle = lss
    mybox: lss.selector
        flex: true
        color: '#ff0000'
        max-width: '100px'
        child: lss.selector
            padding: '1px'

-- moonscript
{
    head {
        meta.title "Hello world!"
        script "https://sth.mjs"
    }
    body {
        div align:'center', style: mystle.mybox {
            div style: mystyle.mybox.child {
                h1 "Hello!"
            }
            div style: mystyle.mybox.child {
                -- content here
            }
        }
    }
}

-- yuescript
return
    * head
        * meta.title "Hello world!"
        * script "https://sth.mjs"
    * body
        * div align:'center', style: mystyle.mybox
            * div style: mystyle.mybox.child
                * h1 "Hello!"
            * div style: mystyle.mybox.child
                -- content here
            
        
